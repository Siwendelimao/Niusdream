# ── 依赖 ──
node_modules/
toolchain/

# ── 运行时数据（会话 / 记忆 / 密钥 / 技能：含用户隐私，绝不入库）──
# ⚠️ 一律锚定根目录（前置 /）：`memory/` 这种写法会匹配到 backend/memory-kernel/core/memory/，
#    把记忆内核源码整目录吞掉（已踩过一次）。
/backend/data/
/backend/logs/
/backend/skills/
/data/
/memory/
/skills/
/external-agents/
/exports/
/backups/

# ── 运行产物（可重建）──
.nis-history/
.nis-repo-index.json
backend/.nis-*.lock

# ── Python ──
__pycache__/
*.pyc

# ── 临时脚本与一次性产物（排障用，用完即删）──
backend/_*
backend/apply-*.cjs
backend/check-*.cjs
backend/fix-*.cjs
backend/test-g4-*.cjs
*.bak
*.bak-*
*.before-*
_bak_*

# ── 本地配置与系统文件 ──
backend/config.json
Thumbs.db
.DS_Store
